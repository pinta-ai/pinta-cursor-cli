{
  "name": "@pinta-ai/pinta-cursor",
  "version": "0.1.0",
  "description": "Pinta AI guard adapter for Cursor IDE and Cursor CLI hooks",
  "main": "dist/index.js",
  "license": "PolyForm-Noncommercial-1.0.0",
  "files": [
    "dist",
    "hooks",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pinta-ai/pinta-cursor.git"
  },
  "homepage": "https://github.com/pinta-ai/pinta-cursor#readme",
  "bugs": {
    "url": "https://github.com/pinta-ai/pinta-cursor/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --minify --outfile=dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@pinta-ai/core": "^0.9.2",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
